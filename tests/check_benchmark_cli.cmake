string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef RUN_ID)
set(RUN_DIR "${OUTPUT_ROOT}/${RUN_ID}")
execute_process(COMMAND "${BENCHMARK_EXE}" --input "${INPUT_FILE}"
    --output-dir "${RUN_DIR}" --warmup 1 --runs 3
    RESULT_VARIABLE RESULT OUTPUT_VARIABLE LOG ERROR_VARIABLE ERR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Benchmark CLI failed: ${LOG} ${ERR}")
endif()
file(STRINGS "${RUN_DIR}/summary.csv" SUMMARY_ROWS)
file(STRINGS "${RUN_DIR}/measurements.csv" RAW_ROWS)
file(STRINGS "${RUN_DIR}/verification.csv" VERIFIED_ROWS)
list(LENGTH SUMMARY_ROWS SUMMARY_COUNT)
list(LENGTH RAW_ROWS RAW_COUNT)
list(LENGTH VERIFIED_ROWS VERIFIED_COUNT)
if(NOT SUMMARY_COUNT EQUAL 7 OR NOT RAW_COUNT EQUAL 19 OR NOT VERIFIED_COUNT EQUAL 7)
    message(FATAL_ERROR "Expected six cases, three measurements per case and all verification rows")
endif()
file(SHA256 "${INPUT_FILE}" EXPECTED_HASH)
foreach(VARIANT baseline base buffer)
    file(SHA256 "${RUN_DIR}/restored/1.${VARIANT}.bin" ACTUAL_HASH)
    if(NOT EXPECTED_HASH STREQUAL ACTUAL_HASH)
        message(FATAL_ERROR "Round-trip file hash differs for ${VARIANT}")
    endif()
endforeach()
file(READ "${RUN_DIR}/status.txt" STATUS)
if(NOT STATUS MATCHES "PASS")
    message(FATAL_ERROR "Missing success status")
endif()
# A second run must not silently replace an existing experiment.
execute_process(COMMAND "${BENCHMARK_EXE}" --input "${INPUT_FILE}"
    --output-dir "${RUN_DIR}" --runs 3 RESULT_VARIABLE REPEAT_RESULT
    OUTPUT_QUIET ERROR_QUIET)
if(REPEAT_RESULT EQUAL 0)
    message(FATAL_ERROR "Existing experiment was overwritten")
endif()
